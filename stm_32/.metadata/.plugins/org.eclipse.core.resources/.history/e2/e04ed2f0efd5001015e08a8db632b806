#include "stm32_sock.h"
#include "oscmessage.hpp"
#include "midi_application.h"

struct udp_pcb *upcb;
int counter = 0;

std::vector<std::vector<char>> ll_buffer;

void sendto(struct udp_pcb *m_nativeSocket, char *data, int size, int not_applicatpple, ip_addr_t *sender_address, int sender_address_size)
{
	struct pbuf *txBuf;

  /* allocate pbuf from pool*/
  txBuf = pbuf_alloc(PBUF_TRANSPORT, size, PBUF_RAM);

  if (txBuf != NULL)
  {
    /* copy data to pbuf */
    pbuf_take(txBuf, data, size);

    /* send udp data */
    udp_send(m_nativeSocket, txBuf);

    /* free pbuf */
    pbuf_free(txBuf);
  }
}

int recvfrom(struct udp_pcb *m_nativeSocket, char *data, int size, int not_applicapple, ip_addr_t *sender_address, int *sender_address_size)
{
	//in case there would be multiple socket's, m_nativeSocket would be used to get to the right buffer
	if(!ll_buffer.size())
		return 0;
	for(int i = 0; i < ll_buffer.front().size(); i++)
		data[i] = ll_buffer.front().at(i);

	ll_buffer.erase(ll_buffer.begin());
	return 1;
}

void udp_receive_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port)
{
	std::vector<char> temp;
	char * raw_data= (char *)p->payload;
	for(int i = 0; i < p->len; i++){
		temp.push_back(raw_data[i]);
	}
	ll_buffer.push_back(temp);
	hekky::osc::OscMessage message = hekky::osc::OscMessage((char *)p->payload, p->len);
	/receive_osc_message(message);


	//counter++;

	pbuf_free(p);
}


